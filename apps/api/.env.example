# Giống dự án web
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
AUTH_SECRET=<chuỗi bí mật dài, giống hệt dự án web>
# Địa chỉ web người dùng (dùng để dựng link mời, link QR)
WEB_URL=https://check-attendance-pi.vercel.app
# Các trang được phép gọi API từ trình duyệt, cách nhau dấu phẩy
CORS_ORIGINS=https://check-attendance-pi.vercel.app
# Email tài khoản quản trị (CMS), cách nhau dấu phẩy
ADMIN_EMAILS=
